/*
 * Инициалы для монограммы. Фото есть не у всех, а силуэт-заглушка читалась
 * как «человека нет». Берём первые буквы двух слов; «Иванов-Петров»
 * считается одним словом, третья буква в квадрат не влезает.
 */
const initials = (name: string): string =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((word) => word[0]?.toUpperCase() ?? '')
    .join('');


