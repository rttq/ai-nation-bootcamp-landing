<section class="section section--white" id="curriculum" aria-label="Программа буткемпа">
  <div class="section__inner">
    <div class="section__head">
      <div class="section__head-l">
        <p class="section__eyebrow">[curriculum] // Программа</p>
        <h2 class="section__title">Программа <br> <span class="section__title-mark">буткемпа</span></h2>
      </div>
      <div class="section__head-r section__head-r--tight">
        <div class="section__rule"></div>
        <button type="button" class="btn btn--outline" data-modal-open="format">Как устроена неделя</button>
      </div>
    </div>

    {/* Пять фактов о формате были пятью серыми плашками — ровно такими же,
        как карточки занятий ниже. Из-за этого иерархия «модуль → занятие»
        не читалась: глаз видел десять одинаковых блоков подряд. Теперь это
        одна строка без заливки, а серый остался только у занятий. */}
    <dl class="facts">
      {formatFacts.map((f) => (
        <div class="facts__item">
          <dt class="label">{f.label}</dt>
          <dd class="facts__value">{f.value}</dd>
        </div>
      ))}
    </dl>

    {modules.map((m) => (
      <div class="module">
        <div class="module__head">
          <span class="module__badge">{m.badge}</span>
          <h3 class="module__title">{m.title}</h3>
          <span class="module__meta">{m.meta}</span>
        </div>
        <div class="program__list">
          {m.lessons.map((l) => (
            <article class="lesson lesson--fold">
              <div class="lesson__head" data-js="lesson-head">
                <div class="lesson__head-text">
                  <p class="lesson__tag">Занятие {l.num}</p>
                  <h4 class="lesson__title">{l.title}</h4>
                </div>
                <button type="button" class="lesson__toggle" data-js="lesson-toggle" aria-expanded={l.num === firstLesson ? 'true' : 'false'} aria-controls={`lesson-${l.num}`} aria-label={`Описание занятия ${l.num}`}></button>
              </div>
              <div class="lesson__top" id={`lesson-${l.num}`} hidden={l.num !== firstLesson}>
                <div class="lesson__l">
                  <ul class="lesson__beats">
                    {toBeats(l.body).map((beat) => <li>{beat}</li>)}
                  </ul>
                </div>
                <div class="lesson__r">
                  <div class="lesson__art">
                    <p class="label">Концепции</p>
                    <ul class="lesson__concepts">
                      {l.concepts.split(' · ').map((c) => <li>{c}</li>)}
                    </ul>
                  </div>
                  {lessonFlows[l.num] && (
                    <div class="lesson__flow">
                      <div class="lesson__flow-svg" set:html={lessonFlows[l.num]} />
                      {/* Та же цепочка строкой — для телефона, где схема шириной
                          468 не помещается и артефакт уезжает за край. */}
                      <p class="lesson__flow-line">
                        <span class="lesson__flow-rubric">{lessonChains[l.num].rubric}</span>
                        {lessonChains[l.num].nodes.map((node, i, all) => (
                          <>
                            {i > 0 && <span class="lesson__flow-arrow" aria-hidden="true">→</span>}
                            <span class={i === all.length - 1 ? 'lesson__flow-node lesson__flow-node--last' : 'lesson__flow-node'}>{node}</span>
                          </>
                        ))}
                      </p>
                    </div>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    ))}

    <div class="cta-row" style="justify-content:center">
      <a class="btn btn--solid" href={managerTgUrl} target="_blank" rel="noopener" data-modal-open="tg">Записаться на буткемп</a>
    </div>
  </div>
</section>

